root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 80

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Acrescente um bloco por diretório GERADO, para o editor não reformatar o que
# a ferramenta reescreve na próxima geração. Exemplo, para migrations de ORM:
#
# [apps/api/prisma/migrations/**]
# insert_final_newline = false
# trim_trailing_whitespace = false
